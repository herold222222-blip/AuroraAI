{
  "name": "auroraai2607",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 vite",
    "dev:api": "NODE_USE_ENV_PROXY=1 tsx server/index.ts",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "dev:pay": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "build:netlify": "tsc -b && vite build --outDir dist2 --emptyOutDir",
    "lint": "oxlint",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "start:api:prod": "node --import tsx server/index.ts",
    "start:api:prod-env": "bash ./scripts/run-local-using-prod-env.sh"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@huggingface/transformers": "^4.2.0",
    "@netlify/blobs": "^10.7.11",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-crop": "^11.1.2",
    "three": "^0.185.1",
    "undici": "^8.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
