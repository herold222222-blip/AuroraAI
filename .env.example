# AuroraAI 环境变量示例（复制为 .env 并按需修改）
# 注意：不要将生产的 .env 提交到版本控制中。

# Postgres 连接（完整 URL）
DATABASE_URL=postgresql://aurora:Herold260428@127.0.0.1:5432/aurora_db

# Redis 连接
REDIS_URL=redis://127.0.0.1:6379

# 阿里云 OSS
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=AKIAXXX
OSS_ACCESS_KEY_SECRET=YOUR_SECRET
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 应用层
AUTH_JWT_SECRET=change_this_to_a_strong_secret
NODE_ENV=production

# 服务端口（可选）
PORT=3000

# 第三方支付/消息推送等（按需添加）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_KEY=
# ========== 密钥（复制为 .env.local，勿提交 Git）==========
GEMINI_API_KEY=your_key_here
PORT=3000
MESHY_API_KEY=your_meshy_key_here

# 千问 / DashScope（Qwen-Image 改图）
DASHSCOPE_API_KEY=your_dashscope_key_here
# 可选：自定义网关（默认北京区 dashscope.aliyuncs.com）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 可选：模型名（默认 qwen-image-edit-plus）
# QWEN_IMAGE_MODEL=qwen-image-edit-plus

# 用户登录 JWT 签名密钥（生产环境务必设置强随机字符串）
AUTH_JWT_SECRET=replace_with_a_long_random_secret

# 阿里云短信（注册 / 修改手机号验证码，必填）
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=灵曦万象
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxx
# 模板变量默认 {"code":"123456"}；若模板字段名不同可自定义，可用 ${code} 占位
# ALIYUN_SMS_TEMPLATE_PARAM={"code":"${code}"}
# ALIYUN_SMS_REGION_ID=cn-hangzhou

# ========== 微信支付 Native 扫码（密钥仅放服务端环境变量，勿写前端）==========
# 全部写入 .env.local（勿提交）。前端不要加 VITE_ 前缀。
#
# —— 本地测支付（推荐：线上登录 + 本机支付）——
# 1) .env.development.local：
#      VITE_DEV_PROXY=true
#      VITE_DEV_PAY_LOCAL=true
#    → /api/auth 等走线上，仅 /api/pay 打本机 :3000
# 2) .env.local 填齐 WECHAT_PAY_*，并设：
#      AUTH_API_ORIGIN=https://www.gnoverse.cn
#      PORT=3000
# 3) 启动：pnpm dev 即可（支付由 Vite 中间件本机处理，无需另开 :3000）
#    也可 pnpm dev:pay（额外起独立 API，一般不必）
# 4) 登录（走线上）→「赞赏我们」→ 确认支付（走本机微信配置）
# 5) 回调不能写 localhost；可用 cloudflared/ngrok，
#    或暂填线上 HTTPS，主要靠前端轮询查单入账。
#
# —— 上线 ——
# 在 Netlify / 服务器环境变量里配置同一套 WECHAT_PAY_*，
# WECHAT_PAY_NOTIFY_URL 改为正式域名，例如：
#   https://www.gnoverse.cn/api/pay/wechat/notify
#
# WECHAT_PAY_APPID=
# WECHAT_PAY_MCHID=
# WECHAT_PAY_SERIAL_NO=          # 商户 API 证书序列号
# WECHAT_PAY_API_V3_KEY=         # APIv3 密钥（32 位）
# WECHAT_PAY_PRIVATE_KEY=        # 商户私钥 PEM（换行可用 \n）
# 或：WECHAT_PAY_PRIVATE_KEY_PATH=/绝对路径/apiclient_key.pem
# WECHAT_PAY_NOTIFY_URL=https://xxxx.trycloudflare.com/api/pay/wechat/notify
# WECHAT_PAY_QR_TTL_SEC=7200
# DONATE_POLL_MAX_MS=300000
# DONATE_MIN_YUAN=0.01
# DONATE_MAX_YUAN=99999

# ========== 域名（已提交 .env.development / .env.production）==========
# VITE_API_ORIGIN=https://www.gnoverse.cn
# 本地开发默认开启代理：请求 /api → VITE_API_ORIGIN（见 .env.development）
# VITE_DEV_PROXY=true
# 本地测支付 / 本机 API：在 .env.development.local 设 VITE_DEV_PROXY=false
