[Unit]
Description=Aurora API (AuroraAI)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/var/www/AuroraAI
Environment=NODE_ENV=production
EnvironmentFile=-/var/www/AuroraAI/.env
EnvironmentFile=-/var/www/AuroraAI/.env.local
# 不要用 pnpm 包一层：部分环境下 pnpm 会提前退出，systemd 误判为服务结束并反复重启
# 导致微信回调打到 Nginx 全是 500，且看不到 [pay] notify hit
ExecStart=/var/www/AuroraAI/node_modules/.bin/tsx /var/www/AuroraAI/server/index.ts
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
